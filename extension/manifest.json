{
  "manifest_version": 3,
  "name": "YouTube Lite Popup Blocker",
  "version": "1.0.0",
  "description": "Blendet wiederkehrende Premium-Upgrade-Popups auf YouTube aus. Für ungestörteres Schauen, ohne Tracking.",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "homepage_url": "https://github.com/ChristopherManzi/youtube-lite-popup-blocker",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
